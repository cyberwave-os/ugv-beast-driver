# Cyberwave UGV Beast driver — example environment.
# Copy to `.env` and fill in. When the driver runs under edge-core, these are
# injected by edge-core; this file documents the knobs and supports standalone
# (docker-compose) runs.

# --- Cyberwave credentials / MQTT ---
CYBERWAVE_TOKEN=your_api_token_here
CYBERWAVE_MQTT_BROKER=mqtt.cyberwave.com
CYBERWAVE_MQTT_PORT=1883

# Rate limiting (1 Hz = 1 second between upstream publishes)
MQTT_PUBLISH_RATE_LIMIT=1.0

# --- UGV velocity limits ---------------------------------------------------
# These env vars are the ONLY software speed cap on the teleop path
# (MQTT locomotion_velocity -> /cmd_vel -> STM32 T:13). The compiled defaults
# are MAX_LINEAR=0.8 / DEFAULT_LINEAR=0.5; override here per deployment.
#   MAX_*     : hard ceiling — every command is clamped to this.
#   DEFAULT_* : cruise speed for the discrete keyboard commands (move_forward...).
# The rover's mechanical top speed is ~1.2 m/s; raise MAX_LINEAR toward it for a
# faster robot (mind the 0.5 s movement watchdog), lower it for tight spaces.
CYBERWAVE_UGV_MAX_LINEAR_SPEED=0.8
CYBERWAVE_UGV_MAX_ANGULAR_SPEED=1.0
CYBERWAVE_UGV_DEFAULT_LINEAR_SPEED=0.5
CYBERWAVE_UGV_DEFAULT_ANGULAR_SPEED=1.0
